# DATABASE (PostgreSQL + Prisma)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# After running scripts/install-postgres.sh, copy from .db-credentials file
DATABASE_URL="postgresql://wedding_admin:CHANGE_THIS_PASSWORD@localhost:5432/wedding_saas?schema=public"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JWT AUTHENTICATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Generate secure random strings (64 characters each):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Access token secret (short-lived tokens)
JWT_SECRET="CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING"

# Refresh token secret (long-lived tokens)
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_HEX_STRING"

# Token expiry times
JWT_ACCESS_EXPIRY="1h"        # Access token expires after 1 hour
JWT_REFRESH_EXPIRY="7d"       # Refresh token expires after 7 days

# Email verification & password reset
EMAIL_VERIFICATION_EXPIRY="24h"  # Email verification link valid for 24 hours
PASSWORD_RESET_EXPIRY="1h"       # Password reset link valid for 1 hour

