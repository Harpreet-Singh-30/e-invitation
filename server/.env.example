# Database Configuration (PostgreSQL / Neon / Supabase)
# For Local Postgres:
DATABASE_URL="postgresql://wedding_admin:admin123@localhost:5432/wedding_saas?schema=public"
DIRECT_URL="postgresql://wedding_admin:admin123@localhost:5432/wedding_saas?schema=public"
# For Cloud Postgres (Neon / Supabase):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Authentication & JWT Secrets
JWT_SECRET="dev-jwt-access-secret-replace-in-production-min32chars"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-replace-in-production-min32chars"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Server Environment
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Uploads & Cloud Storage Configuration
# Option A: Local Disk (default if cloud keys omitted)
MAX_FILE_SIZE=15728640
UPLOAD_DIR="uploads"

# Option B: Supabase Cloud Storage (Free 1GB tier)
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# SUPABASE_STORAGE_BUCKET="invitation-assets"

# Option C: Cloudinary (Free 25GB tier)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# Feature Toggles
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PAYMENTS=true

