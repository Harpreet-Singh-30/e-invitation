# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://wedding_admin:admin123@localhost:5432/wedding_saas?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="dev-jwt-access-secret-replace-in-production-min32chars"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-replace-in-production-min32chars"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Server Environment
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Uploads Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR="uploads"

# Feature Toggles
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PAYMENTS=true
