# ==============================================================================
# InviteHub Server & API Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV="development"
PORT=3000

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://e-invitation-rosy.vercel.app
CORS_ORIGIN="http://localhost:5173,https://e-invitation-rosy.vercel.app"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# For Local Postgres:
DATABASE_URL="postgresql://wedding_admin:admin123@localhost:5432/wedding_saas?schema=public"
DIRECT_URL="postgresql://wedding_admin:admin123@localhost:5432/wedding_saas?schema=public"

# For Cloud Postgres (Supabase / Neon):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------------------------
# Use strong random strings (minimum 32-64 characters) in production
JWT_SECRET="dev-jwt-access-secret-replace-in-production-min32chars"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-replace-in-production-min32chars"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Initial Admin Credentials (used during database seed)
ADMIN_EMAIL="admin@wedding-saas.com"
ADMIN_PASSWORD="admin123"

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Admin Template Studio)
# ------------------------------------------------------------------------------
# Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model: gemini-3.5-flash-lite (fastest ~1s, ultra-reliable)
# Fallbacks automatically handled: gemini-3.8-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PROJECT_NAME=projects/670765406264
GEMINI_PROJECT_NUMBER=670765406264

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
ENABLE_PAYMENTS=true
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ------------------------------------------------------------------------------
# Email & Notification Services (Optional / Planned)
# ------------------------------------------------------------------------------
ENABLE_EMAIL_VERIFICATION=false
# Options: 'smtp' | 'resend' | 'sendgrid'
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# EMAIL_FROM="invites@yourdomain.com"

# SMTP Configuration (if using standard SMTP / Gmail App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ------------------------------------------------------------------------------
# Media & Storage Configuration
# ------------------------------------------------------------------------------
MAX_FILE_SIZE=15728640
UPLOAD_DIR="uploads"

# Optional Cloud Storage (Supabase / Cloudinary)
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="invitation-assets"
