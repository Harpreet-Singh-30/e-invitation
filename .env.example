# ==============================================================================
# InviteHub Platform - Unified Environment Example
# ==============================================================================

# Backend API Configuration
NODE_ENV=production
PORT=3000
CORS_ORIGIN="http://localhost:5173,https://e-invitation-rosy.vercel.app"

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Security & JWT Tokens
JWT_SECRET="generate-a-strong-secret-key-at-least-64-characters"
JWT_REFRESH_SECRET="generate-a-strong-refresh-secret-key-at-least-64-characters"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Admin Authentication
ADMIN_EMAIL="admin@wedding-saas.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Google Gemini AI Studio (Template Synthesizer)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_PROJECT_NAME="projects/670765406264"
GEMINI_PROJECT_NUMBER="670765406264"

# Payment Gateway (Razorpay)
ENABLE_PAYMENTS=true
RAZORPAY_KEY_ID="rzp_live_or_test_key"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Frontend Configuration (web/.env)
VITE_API_URL="https://e-invitation-api-chi.vercel.app"
VITE_APP_NAME="InviteHub - Digital Celebration & Wedding Invitations"
VITE_RAZORPAY_KEY_ID="rzp_live_or_test_key"
