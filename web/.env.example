# ==============================================================================
# InviteHub Frontend Web Environment Configuration
# ==============================================================================

# Backend API Endpoint
# Local Development: http://localhost:3000
# Production (Vercel): https://e-invitation-api-chi.vercel.app
VITE_API_URL=http://localhost:3000

# Application Branding
VITE_APP_NAME="InviteHub - Digital Celebration & Wedding Invitations"

# Razorpay Client Key ID (Public key for checkout popup)
# Test mode format: rzp_test_xxxxxxxxxxxxxx
# Live mode format: rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
